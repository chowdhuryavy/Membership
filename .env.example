# Push Notification VAPID Keys
# Generate using: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Resend API Key for automated emails
RESEND_API_KEY=
VITE_RESEND_API_KEY= # Optional fallback for client-side use

# Note: You also need to set these in Supabase Edge Functions Secrets:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# Google Wallet Configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON= # (Alternative to EMAIL and PRIVATE_KEY)
GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_ID= # (Optional, auto-generated if left empty)
